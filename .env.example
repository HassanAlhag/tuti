# ─── Backend ────────────────────────────────────────────────────
PORT=5055
NODE_ENV=development

# MongoDB connection string. Three options:
#
# 1. Local MongoDB (recommended for development):
#      MONGO_URI=mongodb://localhost:27017/tuti_dev
#
# 2. In-memory seed data, no MongoDB at all:
#      MONGO_URI=
#    (or run ./scripts/preview-seed-mode.sh, which does this for one run
#    without editing this file)
#
# 3. Remote/Atlas (shared dev cluster or production):
#      MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/tuti?retryWrites=true&w=majority&appName=Cluster0
#    The backend prints a non-blocking startup warning if NODE_ENV is not
#    "production" and this points to a non-local host, since local
#    changes would then affect that remote database.
MONGO_URI=mongodb://localhost:27017/tuti_dev

# JWT secrets — use strong random strings in production
JWT_SECRET=change-me-in-production-minimum-32-chars
JWT_REFRESH_SECRET=change-refresh-secret-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend origins for CORS. Include every portal app that calls the API.
CLIENT_ORIGIN=http://localhost:5173
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ─── Product media storage (AWS S3) ──────────────────────────────
# Leave AWS_REGION/AWS_S3_BUCKET empty in development to store optimized
# image variants on local disk instead (dev/test fallback only -- see
# backend/src/shared/s3Storage.js). Both are REQUIRED in production -- the
# server refuses to start without them (see backend/src/config/env.js).
#
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY are OPTIONAL and must be set as a
# pair (never just one). PREFERRED IN PRODUCTION: leave both empty and run
# on an EC2/ECS/Elastic Beanstalk instance with an IAM role attached -- the
# AWS SDK's default credential provider chain picks it up automatically,
# no static keys anywhere. Set both only for local development/testing.
#
# The bucket must stay private (no public-read ACL is ever set). Public
# access is via CloudFront (AWS_CLOUDFRONT_DOMAIN) in production, or a
# short-lived signed URL for local/testing when CloudFront isn't set.
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_CLOUDFRONT_DOMAIN=

# ─── Email (SMTP) ────────────────────────────────────────────────
# Leave empty to log emails to console in development.
# In production, set these to your SMTP provider (SendGrid, Resend, Mailgun, etc.).
# Example: SendGrid uses host=smtp.sendgrid.net, port=587, user=apikey, pass=<api-key>
# Example: Resend uses host=smtp.resend.com, port=465, user=resend, pass=<api-key>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Tuti <noreply@tuti.ae>

# ─── SMS / WhatsApp (Twilio) ─────────────────────────────────────
# Leave empty to log SMS to console in development.
# Supports Twilio SMS and WhatsApp (prefix TWILIO_FROM_NUMBER with whatsapp:)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+971XXXXXXXXX

# ─── Error monitoring (Sentry) ───────────────────────────────────
# Create a project at sentry.io and paste the DSN here.
SENTRY_DSN=
# For the web app Vite builds
VITE_SENTRY_DSN=

# ─── Frontend ────────────────────────────────────────────────────
VITE_API_URL=http://localhost:5055/api

# Portal URLs — used by the web app to link to separate portal apps.
# In production, set these to your deployed subdomain or path.
# In development the web app falls back to localhost port numbers.
VITE_SELLER_URL=http://localhost:5174
VITE_DRIVER_URL=http://localhost:5176
VITE_SR_URL=http://localhost:5177
VITE_ADMIN_URL=http://localhost:5175
